# ── Email Configuration ────────────────────────────────────────────────────────
# Used by /api/contact to send email notifications

# Your Gmail address
EMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your real password)
# How to get it:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (enable it)
#   3. Security → App Passwords
#   4. Create a new App Password → copy the 16-character code
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Where to send contact form emails (defaults to EMAIL_USER if not set)
EMAIL_TO=hello@kurdcod.dev

# ── Site ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin Panel ────────────────────────────────────────────────────────────────
# Password to access /admin
ADMIN_PASSWORD=Awin1998h

# Session secret (change this to something random)
ADMIN_SECRET=kurdcod_admin_2025
